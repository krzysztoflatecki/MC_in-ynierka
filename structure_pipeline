def get_world_spawn(seed: int) -> tuple[int, int]:
    """Zwraca prawdziwe współrzędne spawnu z Cubiomes zamiast (0, 0)."""
    gen_ow = Generator(MC_VERSION, seed, Dimension.DIM_OVERWORLD)
    spawn_pos = get_spawn(gen_ow)
    return int(spawn_pos[0]), int(spawn_pos[1])


def create_biome_sampler(seed: int):
    """Tworzy szybką funkcję próbkującą nazwę biomu w Overworldzie dla zadanego (x, z)."""
    gen_ow = Generator(MC_VERSION, seed, Dimension.DIM_OVERWORLD)

    def sampler(x: int, z: int) -> str:
        # Skala 1:1, wysokość Y=64 (powierzchnia)
        biome_id = get_biome_at(gen_ow, 1, int(x), 64, int(z))
        # Konwersja np. BiomeID.plains -> "plains" lub "minecraft:plains" -> "plains"
        name = str(biome_id).split(".")[-1].split(":")[-1].lower()
        return name

    return sampler
