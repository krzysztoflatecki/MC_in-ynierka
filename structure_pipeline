import pandas as pd
from cubiomespi import *

MC_VERSION = MCVersion.MC_1_16_5


def get_structures_df(seed: int, radius_blocks: int) -> pd.DataFrame:
    results = []

    # Przelicznik: 1 Region to 512 bloków. Określamy zasięg poszukiwań.
    region_radius = max(1, radius_blocks // 512 + 1)

    # 1. OVERWORLD (Wioski, Wraki, Zakopane Skarby)
    gen_ow = Generator(MC_VERSION, seed, Dimension.DIM_OVERWORLD)

    ow_structures = {
        Structure.Village: "Village",
        Structure.Shipwreck: "Shipwreck",
        Structure.Treasure: "Treasure",
    }

    for struct_enum, struct_name in ow_structures.items():
        found = find_structure_in_range(
            gen_ow, struct_enum,
            -region_radius, -region_radius,
            region_radius, region_radius
        )
        if found:
            for x, z in found:
                if abs(x) <= radius_blocks and abs(z) <= radius_blocks:
                    results.append({
                        "node_type": struct_name,
                        "x": x, "z": z,
                        "dimension": "Overworld",
                        "weight": 1.0
                    })

    # Twierdze (najbliższe 3)
    strongholds = get_stronghold_pos(gen_ow, 3)
    if strongholds:
        for x, z in strongholds:
            results.append({"node_type": "Stronghold", "x": x, "z": z, "dimension": "Overworld", "weight": 1.0})

    # 2. NETHER (Jawne mapowanie nazw zamiast 18 i 19)
    gen_net = Generator(MC_VERSION, seed, Dimension.DIM_NETHER)

    nether_structures = {
        Structure.Bastion: "Bastion",
        Structure.Fortress: "Fortress",
    }

    for struct_enum, struct_name in nether_structures.items():
        found_structs = find_structure_in_range(
            gen_net, struct_enum,
            -region_radius, -region_radius,
            region_radius, region_radius
        )
        if found_structs:
            for x, z in found_structs:
                if abs(x) <= radius_blocks and abs(z) <= radius_blocks:
                    results.append({
                        "node_type": struct_name,
                        "x": x, "z": z,
                        "dimension": "Nether",
                        "weight": 1.0
                    })

    df = pd.DataFrame(results)

    # Zabezpieczenie na wypadek braku struktur w danym promieniu
    if not df.empty:
        df = df.drop_duplicates(subset=["node_type", "x", "z"]).reset_index(drop=True)

    return df


